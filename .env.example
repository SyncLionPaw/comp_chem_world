# Copy to .env and fill in:
#   cp .env.example .env
#
# Do not commit .env.

# DeepSeek (V4.1 Flash → API model id: deepseek-flash)
# Claude Code uses DeepSeek's Anthropic-compatible endpoint.
# DEEPSEEK_BASE_URL is the inference endpoint: keep the default, or point it at
# your own Anthropic-compatible gateway. Harbor also accepts ANTHROPIC_BASE_URL
# (DEEPSEEK_BASE_URL wins) or a one-off `harbor run --base-url ...`.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_API_KEY=
