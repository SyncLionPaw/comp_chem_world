# Copy to .env and fill in:
#   cp .env.example .env
#
# Do not commit .env.
#
# Claude Code uses the Anthropic Messages API. Put credentials here, then switch
# models / endpoints freely (see README). Harbor injects ANTHROPIC_* into the agent.

# --- primary (recommended): any Anthropic-compatible endpoint ---
ANTHROPIC_API_KEY=
# Examples:
#   https://api.anthropic.com
#   https://api.deepseek.com/anthropic
#   https://chenglab.xmu.edu.cn/llm
#   https://your-gateway.example/anthropic
ANTHROPIC_BASE_URL=https://chenglab.xmu.edu.cn/llm

# --- optional: provider-native vars (used when model_name's provider prefix matches) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# --- LLM scientific judge for tasks 062-067 (separate verifier) ---
# Can use a different gateway/key than the agent. Empty REWARDKIT_* falls back to ANTHROPIC_*.
# Model id must exist on that gateway (e.g. curl "$REWARDKIT_BASE_URL/v1/models"). Prefer ≥ Sonnet.
# REWARDKIT_API_KEY=
# REWARDKIT_BASE_URL=https://your-judge-gateway.example/llm
# REWARDKIT_JUDGE=anthropic/claude-sonnet-5-5
