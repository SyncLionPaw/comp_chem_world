# Copy to .env and fill in:
#   cp .env.example .env
#
# Do not commit .env.
#
# Claude Code uses the Anthropic Messages API. Put credentials here, then switch
# models / endpoints freely (see README). Harbor injects ANTHROPIC_* into the agent.

# --- primary (recommended): any Anthropic-compatible endpoint ---
ANTHROPIC_API_KEY=
# Examples:
#   https://api.anthropic.com
#   https://api.deepseek.com/anthropic
#   https://your-gateway.example/anthropic
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# --- optional: provider-native vars (used when model_name's provider prefix matches) ---
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
