        /app/environment/assets/science/case07-submit-trusted /app/environment/assets/science/case07-budget.py \
    && chown -R agent:case07 /app/final /app/.cache /app/.codex /home/agent \
    && chown -R root:root /app/environment/assets/science /app/environment/assets/root_service.py /usr/local/share/case07/profile.toml \
    && chmod -R go-rwx /app/environment/assets/science \
    && chmod 0711 /app/environment/assets/science \
    && chmod 0755 /app/environment/assets/science/case07-submit \
    && chmod 0700 /app/environment/assets/root_service.py \
    && chmod 0400 /usr/local/share/case07/profile.toml \
