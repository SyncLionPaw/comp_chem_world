; Corrected SPC/E water topology staged for the replacement Case01 run.
; Explicit pair exclusions follow the GROMACS SETTLE-water topology example.
[ defaults ]
; nbfunc comb-rule gen-pairs fudgeLJ fudgeQQ
1 2 yes 0.5 0.8333333333

[ atomtypes ]
; name  at.num  mass     charge  ptype  sigma(nm)  epsilon(kJ/mol)
OW       8       15.9994  0.0     A      0.316557   0.650194
HW       1       1.0080   0.0     A      0.0        0.0

[ moleculetype ]
; name  nrexcl
SOL     2

[ atoms ]
; nr type resnr residue atom cgnr charge   mass
1    OW   1     SOL     OW   1    -0.8476  15.9994
2    HW   1     SOL     HW1  1     0.4238   1.0080
3    HW   1     SOL     HW2  1     0.4238   1.0080

[ settles ]
; OW index  funct  dOH(nm)  dHH(nm)
1          1       0.1000   0.1633

[ exclusions ]
; All intramolecular nonbonded pairs are excluded.
1          2  3
2          1  3
3          1  2

[ system ]
Bulk SPC/E water, 9033 molecules, 6.5 nm cubic box

[ molecules ]
; molecule  count (gmx solvate updates the runtime copy)
SOL          9033
