FROM comp-chem-world-base
ENV PYTHONDONTWRITEBYTECODE=1 OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 MPLBACKEND=Agg
RUN python3 -m venv /opt/ccb-venv && printf '%s' '' | base64 -d > /tmp/requirements.lock && /opt/ccb-venv/bin/pip install --no-cache-dir --require-hashes -r /tmp/requirements.lock && /opt/ccb-venv/bin/pip check
ENV PATH=/opt/ccb-venv/bin:$PATH
COPY assets/ /app/inputs/
WORKDIR /app
CMD ["python", "--version"]
