  "criteria": [
    {
      "criterion": "forward_chain",
      "level": "L3",
      "necessary": true,
      "verification_basis": {
        "type": "scientific_constraint",
        "source": "Acquired equations/Figure2 parameters and independently FCC-registered model coordinates",
        "rationale": "Recompute bulk eta/site occupations/coverage/free energy/thresholds consistently, source units and constraints correct. No precomputed case05 output copy, no fake native DFT. Gamma_E source inversion stays conditional and dependent. Explicit SI emission branches: lower=mean-sigma_A, upper/athermal=mean; mean+sigma_A is not an author branch."
      },
      "tolerance": "Recompute bulk eta/site occupations/coverage/free energy/thresholds consistently, source units and constraints correct. No precomputed case05 output copy, no fake native DFT. Gamma_E source inversion stays conditional and dependent. Explicit SI emission branches: lower=mean-sigma_A, upper/athermal=mean; mean+sigma_A is not an author branch."
    },
    {
      "criterion": "earliest_crossing",
      "level": "L3",
      "necessary": true,
      "verification_basis": {
        "type": "scientific_constraint",
        "source": "Continuous forward curves and mathematical root/interval/physical-domain rules",
        "rationale": "All earlier possible crossings/tangencies screened with refined bracketing/extrema or an equivalent error-bound certificate. No silent single solver root; no-root bounded to scan domain. Negative gammaF or effective USF invalidates branch, no clipping creates a crossing."
      },
      "tolerance": "All earlier possible crossings/tangencies screened with refined bracketing/extrema or an equivalent error-bound certificate. No silent single solver root; no-root bounded to scan domain. Negative gammaF or effective USF invalidates branch, no clipping creates a crossing."
    },
    {
      "criterion": "uncertainty_and_robustness",
      "level": "L3",
      "necessary": true,
      "verification_basis": {
        "type": "scientific_constraint",
        "source": "Actual source image ranges, published area-scaling spread and fixed declared sensitivity scenarios",
        "rationale": "Source error, physical ensemble spread and model alternatives separate. Classification robust only across relevant valid branches; otherwise uncertain/domain invalid. Report numerical refinement error rather than broad physical scoring tolerance."
      },
      "tolerance": "Source error, physical ensemble spread and model alternatives separate. Classification robust only across relevant valid branches; otherwise uncertain/domain invalid. Report numerical refinement error rather than broad physical scoring tolerance."
    },
    {
      "criterion": "independent_source_comparison",
      "level": "L3",
      "necessary": true,
      "verification_basis": {
        "type": "scientific_constraint",
        "source": "Obtained16-panel/24-root Fig3 digitization, main source classifications and conditions",
        "rationale": "Compare conditional model to source intervals/classes without fitting. Keep experimental and source-theory classes in separate fields. Correctly reported disagreement is a scientific outcome, not automatic failure of coverage or a reason to expand tolerance."
      },
      "tolerance": "Compare conditional model to source intervals/classes without fitting. Keep experimental and source-theory classes in separate fields. Correctly reported disagreement is a scientific outcome, not automatic failure of coverage or a reason to expand tolerance."
    },
    {
      "criterion": "Ni_applicability",
      "level": "L3",
      "necessary": true,
      "verification_basis": {
        "type": "scientific_constraint",
        "source": "Actual Wada thesis TDA lattice cH1, SSRT RRA and fracture morphology intervals under matching charging-condition groups",
        "rationale": "Recompute wtppm->atppm with actual masses, preserve charging543K versus room-temperature testing and fugacity versus pressure; no point-to-point replicate pairing. Grain-boundary IG and total/trapped versus lattice definitions are checked. Ni lacks applicable absorption/USF/surface energy family for this forward model: output out-of-domain rather than a fabricated Ni threshold. Independent Ni experimental pattern may be compared descriptively/quantitatively in its own source units without equating it to PRL Ni domain points."
      },
      "tolerance": "Recompute wtppm->atppm with actual masses, preserve charging543K versus room-temperature testing and fugacity versus pressure; no point-to-point replicate pairing. Grain-boundary IG and total/trapped versus lattice definitions are checked. Ni lacks applicable absorption/USF/surface energy family for this forward model: output out-of-domain rather than a fabricated Ni threshold. Independent Ni experimental pattern may be compared descriptively/quantitatively in its own source units without equating it to PRL Ni domain points."
    },
    {
      "criterion": "actual_prediction_computation",
      "level": "L2",
      "necessary": true,
      "verification_basis": {
        "type": "execution_validity",
        "source": "Reproducible source/hash/code, numerical grids and root reports",
        "rationale": "The forward conditional predictions and source comparison actually executed. Source classifications alone never satisfy end-to-end computation."
      },
      "tolerance": "The forward conditional predictions and source comparison actually executed. Source classifications alone never satisfy end-to-end computation."
    }
  ],
