NAME = opt.inp
|  1> ! WB97X-D3 6-31+G(d) TightSCF DefGrid3 NoRI NoCOSX VeryTightOpt Opt MOREAD
|  2> %pal nprocs 16 end
|  3> %maxcore 1500
|  4> %scf
|  5>   MaxIter 500
|  6> end
|  7> %cpcm
|  8>   smd true
|  9>   SMDsolvent "acetonitrile"
| 10> end
| 11> %moinp "initial.gbw"
| 12> %geom
| 13>   MaxIter 180
| 14> end
| 15> * xyzfile 0 1 initial.xyz
| 16> 
| 17>                          ****END OF INPUT****
