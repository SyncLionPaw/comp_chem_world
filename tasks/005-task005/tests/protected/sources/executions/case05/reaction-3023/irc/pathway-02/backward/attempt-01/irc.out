NAME = irc.inp
|  1> ! WB97X-D3 6-31+G(d) TightSCF DefGrid3 NoRI NoCOSX IRC MOREAD
|  2> %pal nprocs 16 end
|  3> %maxcore 1500
|  4> %scf
|  5>   MaxIter 500
|  6> end
|  7> %cpcm
|  8>   smd true
|  9>   SMDsolvent "acetonitrile"
| 10> end
| 11> %moinp "initial.gbw"
| 12> %irc
| 13>   Direction backward
| 14>   MaxIter 120
| 15>   InitHess read
| 16>   Hess_Filename "initial.hess"
| 17>   HessMode 0
| 18>   TolRMSG 5e-4
| 19>   TolMaxG 2e-3
| 20>   Monitor_Internals
| 21>     {B 5 11}
| 22>     {B 5 6}
| 23>   end
| 24> end
| 25> * xyzfile 0 1 initial.xyz
| 26> 
| 27>                          ****END OF INPUT****
